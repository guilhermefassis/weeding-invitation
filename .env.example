# Supabase — Project Settings > API Keys
# O Supabase renomeou as chaves: "publishable" é a antiga anon, e "secret" é a
# antiga service_role. As variáveis aqui mantêm os nomes antigos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # sb_publishable_...  (vai para o browser)
SUPABASE_SERVICE_ROLE_KEY=       # sb_secret_...       (só no servidor, nunca commitar)

# Só para o `npm run db:setup`. A senha é a do banco (Settings > Database).
# Se sua rede for IPv4, use SUPABASE_DB_URL com a string do Transaction pooler.
SUPABASE_DB_PASSWORD=
# SUPABASE_DB_URL=postgresql://...

# WhatsApp Cloud API (opcional — sem isso o envio é pelo link wa.me)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
